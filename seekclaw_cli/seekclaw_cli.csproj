<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SeekClaw.Cli</RootNamespace>
    <AssemblyName>seekclaw</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\seekclaw_runtime\seekclaw_runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="seekclaw_cli_tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="prompts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <BundledPowerShellDir>$(MSBuildProjectDirectory)/../seekclaw_third_party/powershell/win-x64</BundledPowerShellDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="$(BundledPowerShellDir)/**/*"
             Link="powershell/win-x64/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="VerifyBundledPowerShell" BeforeTargets="PrepareForPublish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('$(BundledPowerShellDir)/pwsh.exe') Or !Exists('$(BundledPowerShellDir)/System.Management.Automation.dll') Or !Exists('$(BundledPowerShellDir)/LICENSE.txt') Or !Exists('$(BundledPowerShellDir)/ThirdPartyNotices.txt')"
           Text="Bundled PowerShell is incomplete. Restore seekclaw_third_party/powershell/win-x64 from the SeekClaw checkout." />
    <VerifyFileHash File="$(BundledPowerShellDir)/pwsh.exe" Hash="e94166ed9f376559c1359bafb08bc49e463a494c330f67644ec1d9f1ffeb5ee5" />
    <VerifyFileHash File="$(BundledPowerShellDir)/System.Management.Automation.dll" Hash="a689b32adcea9a781caa0fbae25ca55ed40f084247fc877d2cbbc8278d283c01" />
  </Target>

</Project>
