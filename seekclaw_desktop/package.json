{
  "name": "seekclaw-desktop",
  "version": "2.0.5",
  "private": true,
  "description": "SeekClaw desktop client",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "pnpm typecheck && electron-vite build",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "author": {
    "name": "SeekClaw",
    "email": "xiaomai@hoilai.com"
  },
  "homepage": "https://github.com/umr-xiaomai/SeekClaw",
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/vue": "^1.52.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.1.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "build": {
    "appId": "com.hoilai.seekclaw",
    "productName": "SeekClaw",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/favicon.ico",
      "target": "nsis",
      "extraResources": [
        {
          "from": "runtime/win-x64",
          "to": "runtime",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "resources/logo.png",
      "target": [
        "dir"
      ],
      "maintainer": "SeekClaw <support@seekclaw.local>",
      "category": "Development",
      "extraResources": [
        {
          "from": "runtime/linux-x64",
          "to": "runtime",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "packageManager": "pnpm@10.33.2"
}