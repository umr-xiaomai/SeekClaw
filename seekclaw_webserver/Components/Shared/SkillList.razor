@rendermode InteractiveServer
@inject SkillService SkillCatalog

<section class="skills-shell" style="max-width: 1200px;">
    <header class="skills-header mb-4 text-center">
        <p class="doc-kicker">ECOSYSTEM MARKETPLACE</p>
        <h1 class="fw-bold mb-2">@(Language == "en" ? "Skills Marketplace" : "技能生态市场")</h1>
        <p class="text-secondary mx-auto" style="max-width: 620px; font-size: 0.95rem;">@(Language == "en" ? "Discover, install, and share domain-specific official & community skills for SeekClaw runtime." : "探索、复用并一键安装面向特定专业领域的 SeekClaw 官方精选与社区扩展技能。")</p>
    </header>

    <!-- Modern Integrated Toolbar -->
    <div class="skills-toolbar-modern">
        <div class="skills-search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input @bind="_query" @bind:event="oninput" placeholder="@(Language == "en" ? "Search by name, slug or author..." : "搜索技能名称、Slug 或作者…")" />
            @if (!string.IsNullOrWhiteSpace(_query))
            {
                <button class="clear-btn" type="button" @onclick="() => _query = string.Empty">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            }
        </div>

        <div class="segmented-bar">
            <button class="segmented-item @(_filterType == "all" ? "active" : "")" type="button" @onclick='() => SetFilter("all")'>
                <i class="bi bi-grid-fill"></i>
                <span>@(Language == "en" ? "All" : "全部")</span>
                <span class="small font-monospace opacity-75">(@_skills.Count)</span>
            </button>
            <button class="segmented-item @(_filterType == "official" ? "active" : "")" type="button" @onclick='() => SetFilter("official")'>
                <i class="bi bi-shield-fill-check text-success"></i>
                <span>@(Language == "en" ? "Official" : "官方精选")</span>
                <span class="small font-monospace opacity-75">(@_skills.Count(s => s.IsOfficial))</span>
            </button>
            <button class="segmented-item @(_filterType == "community" ? "active" : "")" type="button" @onclick='() => SetFilter("community")'>
                <i class="bi bi-stars" style="color: var(--vp-c-brand-1);"></i>
                <span>@(Language == "en" ? "Community" : "社区生态")</span>
                <span class="small font-monospace opacity-75">(@_skills.Count(s => !s.IsOfficial))</span>
            </button>
        </div>

        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm" style="width: auto; height: 34px; font-size: 0.83rem;" @bind="_sortBy" @bind:after="OnSortChanged">
                <option value="default">@(Language == "en" ? "Recommended" : "综合排序")</option>
                <option value="downloads">@(Language == "en" ? "Most Downloaded" : "最多下载")</option>
                <option value="views">@(Language == "en" ? "Most Viewed" : "最多浏览")</option>
                <option value="updated">@(Language == "en" ? "Recently Updated" : "最近更新")</option>
            </select>

            <a class="btn-modern btn-modern-primary" href="@($"{Prefix}/submit")">
                <i class="bi bi-cloud-arrow-up"></i>
                <span>@(Language == "en" ? "Submit" : "发布技能")</span>
            </a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center text-muted py-5">
            <div class="spinner-border text-success mb-2" style="width: 2rem; height: 2rem;"></div>
            <div class="small">@(Language == "en" ? "Loading skills catalog..." : "正在载入技能生态库…")</div>
        </div>
    }
    else if (FilteredSkills.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inbox text-muted fs-1 mb-2"></i>
            <h2 class="h5 fw-bold">@(Language == "en" ? "No matching skills found" : "未找到匹配技能")</h2>
            <p class="small text-secondary">@(Language == "en" ? "Try adjusting your search terms or category filter." : "请尝试更换关键词或重置筛选类别。")</p>
        </div>
    }
    else
    {
        <div class="skills-grid">
            @foreach (var skill in PagedSkills)
            {
                <a class="skill-card-modern" href="@($"{Prefix}/{skill.Slug}")">
                    <div>
                        <div class="d-flex align-items-start gap-3 mb-2">
                            <div class="skill-icon-modern">
                                <i class="bi @(skill.IsOfficial ? "bi-shield-check" : "bi-stars")"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    <h3 class="h6 fw-semibold text-truncate m-0" title="@skill.Name">@skill.Name</h3>
                                    @if (skill.IsOfficial)
                                    {
                                        <span class="badge-subtle badge-subtle-success flex-shrink-0">
                                            <span class="dot"></span>@(Language == "en" ? "Official" : "官方")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-subtle badge-subtle-neutral flex-shrink-0">
                                            <span class="dot"></span>@(Language == "en" ? "Community" : "社区")
                                        </span>
                                    }
                                </div>
                                <div class="font-monospace text-muted small" style="font-size: 0.76rem;">@skill.Slug</div>
                            </div>
                        </div>

                        <p class="skill-card-desc">@skill.Summary</p>
                    </div>

                    <div class="skill-card-meta-line">
                        <div class="skill-meta-tags">
                            <span class="skill-meta-item" title="@(Language == "en" ? "Author" : "作者")">
                                <i class="bi bi-person"></i>@skill.Author
                            </span>
                            <span class="text-muted" style="opacity: 0.4;">·</span>
                            <span class="skill-meta-item" title="@(Language == "en" ? "Downloads" : "累计下载")">
                                <i class="bi bi-download"></i>@skill.DownloadCount
                            </span>
                            <span class="text-muted" style="opacity: 0.4;">·</span>
                            <span class="skill-meta-item" title="@(Language == "en" ? "Views" : "累计浏览")">
                                <i class="bi bi-eye"></i>@skill.ViewCount
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (skill.HasPackage)
                            {
                                <span class="badge-subtle badge-subtle-info">Zip</span>
                            }
                            <span class="skill-version-pill">v@skill.Version</span>
                        </div>
                    </div>
                </a>
            }
        </div>

        @if (TotalPages > 1)
        {
            <div class="site-pagination mt-4 justify-content-center">
                <div class="admin-page-nav">
                    <button class="admin-page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(1)">
                        <i class="bi bi-chevron-double-left"></i>
                    </button>
                    <button class="admin-page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(_currentPage - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    @for (int p = StartPage; p <= EndPage; p++)
                    {
                        var pageNum = p;
                        <button class="admin-page-btn @(pageNum == _currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }
                    <button class="admin-page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="() => GoToPage(_currentPage + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button class="admin-page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="() => GoToPage(TotalPages)">
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                </div>
            </div>
        }
    }
</section>

@code {
    [Parameter]
    public string Language { get; set; } = "zh";

    private List<SkillSummary> _skills = new();
    private string _query = string.Empty;
    private string _filterType = "all";
    private string _sortBy = "default";
    private bool _loading = true;
    private int _currentPage = 1;
    private int _pageSize = 12;
    private string Prefix => Language == "en" ? "/en/skills" : "/skills";

    private List<SkillSummary> FilteredSkills
    {
        get
        {
            var querySkills = _skills.AsEnumerable();
            if (_filterType == "official")
            {
                querySkills = querySkills.Where(s => s.IsOfficial);
            }
            else if (_filterType == "community")
            {
                querySkills = querySkills.Where(s => !s.IsOfficial);
            }

            if (!string.IsNullOrWhiteSpace(_query))
            {
                querySkills = querySkills.Where(s =>
                    s.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                    s.Slug.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                    s.Summary.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                    s.Author.Contains(_query, StringComparison.OrdinalIgnoreCase));
            }

            return querySkills.ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredSkills.Count / (double)_pageSize));

    private List<SkillSummary> PagedSkills =>
        FilteredSkills.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    private int StartPage => Math.Max(1, _currentPage - 2);
    private int EndPage => Math.Min(TotalPages, StartPage + 4);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _skills = await SkillCatalog.ListAsync(
            includeDisabled: false,
            reviewStatus: SkillReviewStatus.Approved,
            sortBy: _sortBy);
        _loading = false;
    }

    private async Task OnSortChanged()
    {
        _currentPage = 1;
        await LoadAsync();
    }

    private void SetFilter(string type)
    {
        _filterType = type;
        _currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page > TotalPages) page = TotalPages;
        _currentPage = page;
    }
}
