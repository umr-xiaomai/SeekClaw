@page "/admin/users"
@attribute [Authorize(Roles = "SuperAdmin")]
@layout AdminLayout
@rendermode InteractiveServer
@inject AuthService Auth
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>用户与权限 — SeekClaw 后台</PageTitle>

<section class="admin-shell">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <p class="doc-kicker">User Management</p>
            <h1 class="h2 fw-bold m-0">用户与权限管理</h1>
        </div>
        <a class="vp-btn-secondary" href="/admin"><i class="bi bi-arrow-left"></i> 返回控制台</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mb-3"><i class="bi bi-exclamation-triangle"></i> @_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-success mb-3"><i class="bi bi-check2-circle"></i> @_message</div>
    }

    <div class="admin-table">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>注册邮箱</th>
                    <th>角色权限</th>
                    <th>注册时间</th>
                    <th class="text-end" style="width: 260px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users)
                {
                    var isCurrentUser = string.Equals(user.Username, _currentUsername, StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td><span class="badge text-bg-light border">#@user.Id</span></td>
                        <td>
                            <i class="bi bi-envelope me-1 text-muted"></i>
                            <strong>@user.Username</strong>
                            @(isCurrentUser ? " (当前登录)" : "")
                        </td>
                        <td>
                            @if (user.IsSuperAdmin)
                            {
                                <span class="badge text-bg-danger"><i class="bi bi-shield-fill-check me-1"></i>超级管理员</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">普通用户</span>
                            }
                        </td>
                        <td>@DateTimeOffset.FromUnixTimeMilliseconds(user.CreatedAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" @onclick="() => OpenResetPasswordModal(user)" title="重置密码">
                                    <i class="bi bi-key"></i> 改密
                                </button>
                                @if (!isCurrentUser)
                                {
                                    <button class="btn btn-outline-warning" @onclick="() => ToggleSuperAdminAsync(user)" title="切换角色">
                                        <i class="bi bi-shield-shaded"></i> @(user.IsSuperAdmin ? "取消超管" : "设为超管")
                                    </button>
                                    <button class="btn btn-outline-danger" @onclick="() => _deleteTarget = user" title="删除用户">
                                        <i class="bi bi-trash3"></i> 删除
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_passwordTarget is not null)
    {
        <div class="admin-modal-backdrop" @onclick="CloseResetPasswordModal"></div>
        <div class="admin-modal-dialog">
            <div class="admin-modal-content">
                <div class="admin-modal-header">
                    <h3 class="h5 fw-bold m-0"><i class="bi bi-key me-2"></i>重置密码</h3>
                    <button type="button" class="btn-close" @onclick="CloseResetPasswordModal" aria-label="Close"></button>
                </div>
                <div class="admin-modal-body">
                    <p class="mb-2">为用户 <strong>@_passwordTarget.Username</strong> 设置新密码（至少 6 位）：</p>
                    <input type="password" class="form-control" @bind="_newPassword" placeholder="请输入新密码" />
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="alert alert-danger mt-2 mb-0 py-2">@_modalError</div>
                    }
                </div>
                <div class="admin-modal-footer">
                    <button class="vp-btn-secondary" type="button" @onclick="CloseResetPasswordModal">取消</button>
                    <button class="btn btn-primary" type="button" @onclick="ConfirmResetPasswordAsync">确认重置</button>
                </div>
            </div>
        </div>
    }

    @if (_deleteTarget is not null)
    {
        <div class="admin-modal-backdrop" @onclick="() => _deleteTarget = null"></div>
        <div class="admin-modal-dialog">
            <div class="admin-modal-content">
                <div class="admin-modal-header">
                    <h3 class="h5 fw-bold m-0 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>确认删除用户</h3>
                    <button type="button" class="btn-close" @onclick="() => _deleteTarget = null" aria-label="Close"></button>
                </div>
                <div class="admin-modal-body">
                    <p class="mb-0">确认删除用户“<strong>@_deleteTarget.Username</strong>”吗？此操作不可逆。</p>
                </div>
                <div class="admin-modal-footer">
                    <button class="vp-btn-secondary" type="button" @onclick="() => _deleteTarget = null">取消</button>
                    <button class="btn btn-danger" type="button" @onclick="ConfirmDeleteUserAsync">确认删除</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<User> _users = new();
    private string? _currentUsername;
    private string? _error;
    private string? _message;
    private User? _passwordTarget;
    private User? _deleteTarget;
    private string _newPassword = string.Empty;
    private string? _modalError;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUsername = authState.User.Identity?.Name;
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _users = await Auth.ListUsersAsync();
    }

    private async Task ToggleSuperAdminAsync(User user)
    {
        _error = null;
        _message = null;
        var nextVal = !user.IsSuperAdmin;
        var success = await Auth.SetSuperAdminAsync(user.Id, nextVal);
        if (success)
        {
            _message = $"已将用户 {user.Username} 的权限变更为：{(nextVal ? "超级管理员" : "普通用户")}。";
            await LoadUsersAsync();
        }
        else
        {
            _error = "无法更新用户权限。";
        }
    }

    private void OpenResetPasswordModal(User user)
    {
        _passwordTarget = user;
        _newPassword = string.Empty;
        _modalError = null;
    }

    private void CloseResetPasswordModal()
    {
        _passwordTarget = null;
        _newPassword = string.Empty;
        _modalError = null;
    }

    private async Task ConfirmResetPasswordAsync()
    {
        var user = _passwordTarget;
        if (user is null)
        {
            return;
        }

        if (_newPassword.Length < 6)
        {
            _modalError = "密码长度至少需要 6 位。";
            return;
        }

        try
        {
            var success = await Auth.ResetPasswordAsync(user.Id, _newPassword);
            if (success)
            {
                _message = $"用户 {user.Username} 的密码已成功重置。";
                CloseResetPasswordModal();
            }
            else
            {
                _modalError = "重置密码失败。";
            }
        }
        catch (Exception ex)
        {
            _modalError = $"重置密码失败：{ex.Message}";
        }
    }

    private async Task ConfirmDeleteUserAsync()
    {
        var user = _deleteTarget;
        if (user is null)
        {
            return;
        }

        try
        {
            var success = await Auth.DeleteUserAsync(user.Id);
            if (success)
            {
                _message = $"用户 {user.Username} 已被删除。";
            }
            else
            {
                _error = "删除用户失败。";
            }
        }
        catch (Exception ex)
        {
            _error = $"删除用户失败：{ex.Message}";
        }
        finally
        {
            _deleteTarget = null;
        }

        await LoadUsersAsync();
    }
}
}

