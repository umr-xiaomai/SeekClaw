@page "/admin/skills"
@attribute [Authorize(Roles = "SuperAdmin")]
@layout AdminLayout
@rendermode InteractiveServer
@inject SkillService Skills

<PageTitle>技能插件管理 — SeekClaw 管理后台</PageTitle>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert-modern alert-modern-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
        <div class="flex-grow-1">@_error</div>
        <button type="button" class="btn-close" style="font-size: 0.75rem;" @onclick="() => _error = null"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert-modern alert-modern-info mb-3">
        <i class="bi bi-check-circle-fill fs-5 flex-shrink-0 text-success"></i>
        <div class="flex-grow-1">@_message</div>
        <button type="button" class="btn-close" style="font-size: 0.75rem;" @onclick="() => _message = null"></button>
    </div>
}

<!-- Card Container (Matching Image 1 Card Style) -->
<div class="admin-card-container">
    <!-- Top Toolbar: Search with Blue Search Button, Refresh, Create (Image 1 Style) -->
    <div class="admin-table-toolbar-box">
        <div class="admin-search-group">
            <i class="bi bi-search search-icon"></i>
            <input @bind="_searchQuery" @bind:event="oninput" placeholder="搜索标题、正文、作者或标签…" />
            <button class="btn-search-blue" type="button" @onclick="ApplySearch">
                <i class="bi bi-search"></i> 搜索
            </button>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn-modern btn-modern-sm" type="button" @onclick="RefreshAsync" title="刷新最新数据">
                <i class="bi bi-arrow-repeat"></i> 最新
            </button>
            <button class="btn-modern btn-modern-sm btn-modern-primary" @onclick="OpenCreateModal">
                <i class="bi bi-plus-lg"></i> 发布官方技能
            </button>
        </div>
    </div>

    <!-- Category Filter Tabs (Segmented Pills) -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom">
        <div class="segmented-bar">
            <button type="button" class="segmented-item @(_filterType == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>
                全部 (@_skills.Count)
            </button>
            <button type="button" class="segmented-item @(_filterType == "pending" ? "active" : "")" @onclick='() => SetFilter("pending")'>
                <span class="dot" style="width: 6px; height: 6px; border-radius: 50%; background: #f59e0b;"></span>
                待审核 (@_skills.Count(s => s.ReviewStatus == SkillReviewStatus.Pending))
            </button>
            <button type="button" class="segmented-item @(_filterType == "official" ? "active" : "")" @onclick='() => SetFilter("official")'>
                <span class="dot" style="width: 6px; height: 6px; border-radius: 50%; background: #10b981;"></span>
                官方精选 (@_skills.Count(s => s.IsOfficial))
            </button>
            <button type="button" class="segmented-item @(_filterType == "community" ? "active" : "")" @onclick='() => SetFilter("community")'>
                社区已上架 (@_skills.Count(s => !s.IsOfficial && s.ReviewStatus == SkillReviewStatus.Approved))
            </button>
            <button type="button" class="segmented-item @(_filterType == "rejected" ? "active" : "")" @onclick='() => SetFilter("rejected")'>
                已驳回 (@_skills.Count(s => s.ReviewStatus == SkillReviewStatus.Rejected))
            </button>
        </div>

        <select class="form-select form-select-sm" style="width: auto; height: 32px; font-size: 0.8rem;" @bind="_pageSize">
            <option value="10">10 条/页</option>
            <option value="20">20 条/页</option>
            <option value="50">50 条/页</option>
        </select>
    </div>

    <!-- Table (Image 1 Layout: ID, 类型, 内容, 作者, 互动, 操作) -->
    <div class="table-responsive">
        <table class="table-admin-modern">
            <thead>
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th style="width: 90px;">类型</th>
                    <th>内容</th>
                    <th style="width: 140px;">作者</th>
                    <th style="width: 130px;">互动度量</th>
                    <th class="text-end" style="width: 200px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                            正在加载技能列表…
                        </td>
                    </tr>
                }
                else if (PagedSkills.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            未找到符合条件的技能插件。
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var skill in PagedSkills)
                    {
                        <tr>
                            <!-- ID -->
                            <td class="font-monospace text-muted small">@skill.Id</td>

                            <!-- 类型 -->
                            <td>
                                @if (skill.IsOfficial)
                                {
                                    <span class="badge-subtle badge-subtle-success"><span class="dot"></span>官方</span>
                                }
                                else
                                {
                                    <span class="badge-subtle badge-subtle-info"><span class="dot"></span>社区</span>
                                }
                            </td>

                            <!-- 内容 (Title, slug, summary) -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark-emphasis">@skill.Name</span>
                                    <span class="skill-version-pill">v@skill.Version</span>
                                    @if (skill.ReviewStatus == SkillReviewStatus.Pending)
                                    {
                                        <span class="badge-subtle badge-subtle-warning"><span class="dot"></span>待审核</span>
                                    }
                                    else if (skill.ReviewStatus == SkillReviewStatus.Rejected)
                                    {
                                        <span class="badge-subtle badge-subtle-danger"><span class="dot"></span>已驳回</span>
                                    }
                                </div>
                                <div class="text-muted font-monospace small" style="font-size: 0.74rem;">@skill.Slug</div>
                                <p class="text-secondary small m-0 mt-1" style="line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @skill.Summary
                                </p>
                            </td>

                            <!-- 作者 -->
                            <td>
                                <div class="small fw-semibold">@skill.Author</div>
                                @if (!string.IsNullOrWhiteSpace(skill.AuthorUsername))
                                {
                                    <div class="text-muted small font-monospace" style="font-size: 0.72rem;">@@@skill.AuthorUsername</div>
                                }
                            </td>

                            <!-- 互动 -->
                            <td>
                                <div class="small font-monospace text-secondary">
                                    <div title="下载安装量"><i class="bi bi-download me-1 text-muted"></i>@skill.DownloadCount 赞/下</div>
                                    <div title="页面浏览量" class="mt-1"><i class="bi bi-eye me-1 text-muted"></i>@skill.ViewCount 浏览</div>
                                </div>
                            </td>

                            <!-- 操作 (Matching Image 1 Action Icons & Buttons) -->
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <!-- Preview Eye -->
                                    <a class="admin-action-btn-circle" href="@($"/skills/{skill.Slug}")" target="_blank" title="预览技能前台主页">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <!-- Edit Pencil -->
                                    <button class="admin-action-btn-circle" @onclick="() => OpenEditModalAsync(skill.Id)" title="编辑元信息">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- Audit / Review (Orange Pill if Pending/Rejected) -->
                                    @if (skill.ReviewStatus != SkillReviewStatus.Approved)
                                    {
                                        <button class="admin-action-btn-pill btn-pill-orange" @onclick="() => OpenReviewModal(skill)" title="审核此技能">
                                            <i class="bi bi-clipboard-check"></i> 审核
                                        </button>
                                    }

                                    <!-- Online / Offline Toggle -->
                                    <button class="admin-action-btn-circle @(skill.Enabled ? "text-warning" : "text-success")" @onclick="() => ToggleEnabledAsync(skill)" title="@(skill.Enabled ? "下线隐藏" : "恢复上线")">
                                        <i class="bi @(skill.Enabled ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>

                                    <!-- Delete (Red) -->
                                    <button class="admin-action-btn-circle text-danger" @onclick="() => ConfirmDelete(skill)" title="删除此技能">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (TotalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3 pt-2 border-top">
            <span class="small text-muted font-monospace">共 @_skills.Count 条记录，当前第 @_currentPage / @TotalPages 页</span>
            <div class="admin-pagination">
                <button class="admin-page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(1)" title="首页">
                    <i class="bi bi-chevron-double-left"></i>
                </button>
                <button class="admin-page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(_currentPage - 1)" title="上一页">
                    <i class="bi bi-chevron-left"></i>
                </button>

                @for (var p = StartPage; p <= EndPage; p++)
                {
                    var pageNum = p;
                    <button class="admin-page-btn @(pageNum == _currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }

                <button class="admin-page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="() => GoToPage(_currentPage + 1)" title="下一页">
                    <i class="bi bi-chevron-right"></i>
                </button>
                <button class="admin-page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="() => GoToPage(TotalPages)" title="末页">
                    <i class="bi bi-chevron-double-right"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal Dialog for Skill Review -->
@if (_showReviewModal && _reviewTarget != null)
{
    <div class="admin-modal-backdrop" @onclick="() => _showReviewModal = false"></div>
    <div class="admin-modal-dialog">
        <div class="admin-modal-content">
            <div class="admin-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard-check text-primary fs-5"></i>
                    <h3 class="h6 fw-bold m-0">审核社区技能</h3>
                </div>
                <button type="button" class="btn-close" @onclick="() => _showReviewModal = false" aria-label="Close"></button>
            </div>
            <div class="admin-modal-body">
                <div class="aside-card mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="fw-bold">@_reviewTarget.Name</span>
                        <span class="skill-version-pill">@_reviewTarget.Slug</span>
                    </div>
                    <p class="small text-secondary m-0">@_reviewTarget.Summary</p>
                    <div class="small text-muted mt-2">作者：@_reviewTarget.Author (@@@_reviewTarget.AuthorUsername)</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted">审核结论 *</label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="reviewStatusRadio" id="revApproved" value="@SkillReviewStatus.Approved" checked="@(_reviewStatusChoice == SkillReviewStatus.Approved)" @onchange='() => _reviewStatusChoice = SkillReviewStatus.Approved' />
                            <label class="form-check-label text-success fw-bold small" for="revApproved">
                                <i class="bi bi-check-circle me-1"></i> 通过审核并上架
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="reviewStatusRadio" id="revRejected" value="@SkillReviewStatus.Rejected" checked="@(_reviewStatusChoice == SkillReviewStatus.Rejected)" @onchange='() => _reviewStatusChoice = SkillReviewStatus.Rejected' />
                            <label class="form-check-label text-danger fw-bold small" for="revRejected">
                                <i class="bi bi-x-circle me-1"></i> 驳回该技能
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted">审核意见 / 驳回理由</label>
                    <textarea class="form-control form-control-sm" rows="3" @bind="_reviewComment" placeholder="如驳回，请向开发者说明原因或改进建议…"></textarea>
                </div>
            </div>
            <div class="admin-modal-footer">
                <button class="btn-modern" type="button" @onclick="() => _showReviewModal = false">取消</button>
                <button class="btn-modern btn-modern-primary" disabled="@_reviewing" @onclick="SubmitReviewAsync">
                    <i class="bi bi-send"></i> @(_reviewing ? "正在提交…" : "确认审核结果")
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal Dialog for Create/Edit Skill -->
@if (_showModal)
{
    <div class="admin-modal-backdrop" @onclick="CloseModal"></div>
    <div class="admin-modal-dialog">
        <div class="admin-modal-content">
            <div class="admin-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi @(_editingId is null ? "bi-plus-circle" : "bi-pencil-square") text-primary fs-5"></i>
                    <h3 class="h6 fw-bold m-0 text-dark-emphasis">@(_editingId is null ? "发布官方技能插件" : $"编辑技能插件 (#{_editingId})")</h3>
                </div>
                <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
            </div>

            <div class="admin-modal-body">
                @if (!string.IsNullOrWhiteSpace(_modalError))
                {
                    <div class="alert-modern alert-modern-danger mb-3 py-2"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_modalError</div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted">技能名称 *</label>
                        <input class="form-control form-control-sm" @bind="_model.Name" placeholder="例如：.NET 10 开发助手" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted">Slug 标识（留空自动生成）</label>
                        <input class="form-control form-control-sm" @bind="_model.Slug" placeholder="例如：dotnet-dev" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">作者署名</label>
                        <input class="form-control form-control-sm" @bind="_model.Author" placeholder="SeekClaw Team" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">版本号</label>
                        <input class="form-control form-control-sm font-monospace" @bind="_model.Version" placeholder="1.0.0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">主页 / 仓库</label>
                        <input class="form-control form-control-sm" @bind="_model.Homepage" placeholder="https://github.com/..." />
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-muted">一句话简介 *</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_model.Summary" placeholder="一句话概括此技能的主要功能与使用场景"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-muted">README Markdown 文档与提示词规格 *</label>
                        <textarea class="form-control form-control-sm font-monospace" rows="10" @bind="_model.ReadmeMarkdown" placeholder="# 技能名称&#10;&#10;## 功能特性&#10;&#10;## 使用方式"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted">技能压缩包（.zip / .md / .json，最大 10MB）</label>
                        <InputFile class="form-control form-control-sm" OnChange="OnPackageSelected" accept=".zip,.md,.txt,.json" />
                        @if (_packageData is not null)
                        {
                            <div class="form-text text-success small"><i class="bi bi-check-circle-fill me-1"></i> 已选择：@_packageFileName (@((_packageData.Length / 1024.0).ToString("F1")) KB)</div>
                        }
                        else if (_editingId is not null)
                        {
                            <div class="form-text text-muted small">留空则保持当前已有的技能压缩包不变。</div>
                        }
                    </div>
                    <div class="col-md-6 d-flex flex-column justify-content-end gap-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="modalOfficial" @bind="_model.IsOfficial" />
                            <label class="form-check-label ms-2 small fw-bold text-success" for="modalOfficial">
                                <i class="bi bi-shield-check"></i> 设为官方认证技能
                            </label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="modalEnabled" @bind="_model.Enabled" />
                            <label class="form-check-label ms-2 small" for="modalEnabled">在技能市场公开展示</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-modal-footer">
                <button class="btn-modern" type="button" @onclick="CloseModal">取消</button>
                <button class="btn-modern btn-modern-primary" disabled="@_saving" @onclick="SaveAsync">
                    <i class="bi bi-save"></i> @(_saving ? "正在保存…" : "保存技能")
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal Dialog for Delete Confirmation -->
@if (_deleteTarget is not null)
{
    <div class="admin-modal-backdrop" @onclick="CancelDelete"></div>
    <div class="admin-modal-dialog">
        <div class="admin-modal-content" style="max-width: 460px;">
            <div class="admin-modal-header">
                <div class="d-flex align-items-center gap-2 text-danger">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <h3 class="h6 fw-bold m-0">确认删除技能插件</h3>
                </div>
                <button type="button" class="btn-close" @onclick="CancelDelete" aria-label="Close"></button>
            </div>
            <div class="admin-modal-body">
                <p class="mb-2">确定要彻底删除技能 <strong>@_deleteTarget.Name</strong>（<code>@_deleteTarget.Slug</code>）吗？</p>
                <div class="alert-modern alert-modern-danger py-2 mb-0 small">
                    此操作将删除该技能的所有历史版本及离线包文件，且不可逆。
                </div>
            </div>
            <div class="admin-modal-footer">
                <button class="btn-modern" type="button" @onclick="CancelDelete">取消</button>
                <button class="btn-modern btn-modern-danger" @onclick="ExecuteDeleteAsync">
                    <i class="bi bi-trash"></i> 确认删除
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<SkillSummary> _skills = new();
    private bool _loading = true;
    private string? _error;
    private string? _message;
    private string _searchQuery = "";
    private string _filterType = "all";
    private int _currentPage = 1;
    private int _pageSize = 10;

    // Review Modal State
    private bool _showReviewModal;
    private SkillSummary? _reviewTarget;
    private string _reviewStatusChoice = SkillReviewStatus.Approved;
    private string _reviewComment = "";
    private bool _reviewing;

    // Create / Edit Modal State
    private bool _showModal;
    private int? _editingId;
    private SkillInput _model = new();
    private byte[]? _packageData;
    private string? _packageFileName;
    private string? _packageContentType;
    private bool _saving;
    private string? _modalError;

    // Delete Modal State
    private SkillSummary? _deleteTarget;

    private IEnumerable<SkillSummary> FilteredSkills
    {
        get
        {
            var q = _skills.AsEnumerable();

            if (_filterType == "pending")
            {
                q = q.Where(s => s.ReviewStatus == SkillReviewStatus.Pending);
            }
            else if (_filterType == "official")
            {
                q = q.Where(s => s.IsOfficial);
            }
            else if (_filterType == "community")
            {
                q = q.Where(s => !s.IsOfficial && s.ReviewStatus == SkillReviewStatus.Approved);
            }
            else if (_filterType == "rejected")
            {
                q = q.Where(s => s.ReviewStatus == SkillReviewStatus.Rejected);
            }

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var keyword = _searchQuery.Trim();
                q = q.Where(s =>
                    s.Name.Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    s.Slug.Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    s.Author.Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrWhiteSpace(s.AuthorUsername) && s.AuthorUsername.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                    s.Summary.Contains(keyword, StringComparison.OrdinalIgnoreCase));
            }

            return q;
        }
    }

    private List<SkillSummary> PagedSkills =>
        FilteredSkills.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    private int TotalFilteredCount => FilteredSkills.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalFilteredCount / (double)_pageSize));
    private int StartPage => Math.Max(1, _currentPage - 2);
    private int EndPage => Math.Min(TotalPages, StartPage + 4);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _skills = await Skills.ListAsync(includeDisabled: true);
        _loading = false;
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
    }

    private void ApplySearch()
    {
        _currentPage = 1;
        StateHasChanged();
    }

    private void SetFilter(string type)
    {
        _filterType = type;
        _currentPage = 1;
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page > TotalPages) page = TotalPages;
        _currentPage = page;
    }

    private void OpenReviewModal(SkillSummary skill)
    {
        _reviewTarget = skill;
        _reviewStatusChoice = SkillReviewStatus.Approved;
        _reviewComment = skill.ReviewComment ?? "";
        _showReviewModal = true;
    }

    private async Task SubmitReviewAsync()
    {
        if (_reviewTarget == null) return;
        _reviewing = true;
        try
        {
            await Skills.ReviewSkillAsync(_reviewTarget.Id, _reviewStatusChoice, _reviewComment);
            _message = $"技能【{_reviewTarget.Name}】审核操作完成，当前状态为：{(_reviewStatusChoice == SkillReviewStatus.Approved ? "审核通过已上架" : "已驳回")}";
            _showReviewModal = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "审核操作失败：" + ex.Message;
        }
        finally
        {
            _reviewing = false;
        }
    }

    private void OpenCreateModal()
    {
        _editingId = null;
        _model = new SkillInput
        {
            Enabled = true,
            IsOfficial = true,
            Version = "1.0.0",
            Author = "SeekClaw Team"
        };
        _packageData = null;
        _packageFileName = null;
        _packageContentType = null;
        _modalError = null;
        _showModal = true;
    }

    private async Task OpenEditModalAsync(int id)
    {
        var detail = await Skills.GetDetailAsync(id);
        if (detail is null)
        {
            _error = "未找到指定技能。";
            return;
        }

        _editingId = id;
        _model = new SkillInput
        {
            Name = detail.Name,
            Slug = detail.Slug,
            Summary = detail.Summary,
            ReadmeMarkdown = detail.ReadmeMarkdown,
            Author = detail.Author,
            Version = detail.Version,
            Homepage = detail.Homepage,
            IsOfficial = detail.IsOfficial,
            Enabled = detail.Enabled
        };
        _packageData = null;
        _packageFileName = null;
        _packageContentType = null;
        _modalError = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingId = null;
        _modalError = null;
    }

    private async Task OnPackageSelected(InputFileChangeEventArgs e)
    {
        _modalError = null;
        var file = e.File;
        if (file is null) return;

        if (file.Size > SkillService.MaxPackageSizeBytes)
        {
            _modalError = "文件大小不能超过 10MB。";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: SkillService.MaxPackageSizeBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _packageData = memory.ToArray();
            _packageFileName = file.Name;
            _packageContentType = file.ContentType;
        }
        catch (Exception ex)
        {
            _modalError = "读取上传文件失败：" + ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _modalError = "技能名称不能为空。";
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.ReadmeMarkdown))
        {
            _modalError = "README 说明文档不能为空。";
            return;
        }

        _saving = true;
        try
        {
            if (_editingId is null)
            {
                await Skills.CreateAsync(
                    _model,
                    _packageData,
                    _packageFileName,
                    _packageContentType,
                    _model.IsOfficial,
                    authorUserId: null,
                    authorUsername: null);
                _message = $"官方技能【{_model.Name}】创建成功并已上架！";
            }
            else
            {
                await Skills.UpdateAsync(
                    _editingId.Value,
                    _model,
                    _packageData,
                    _packageFileName,
                    _packageContentType);
                _message = $"技能【{_model.Name}】已更新！";
            }

            CloseModal();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleEnabledAsync(SkillSummary skill)
    {
        var newStatus = !skill.Enabled;
        await Skills.SetEnabledAsync(skill.Id, newStatus);
        skill = skill with { Enabled = newStatus };
        _message = $"技能【{skill.Name}】已成功{(newStatus ? "恢复上线展示" : "下线隐藏")}。";
        await LoadAsync();
    }

    private void ConfirmDelete(SkillSummary skill)
    {
        _deleteTarget = skill;
    }

    private void CancelDelete()
    {
        _deleteTarget = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        var name = _deleteTarget.Name;
        await Skills.DeleteAsync(_deleteTarget.Id);
        _deleteTarget = null;
        _message = $"技能【{name}】已被彻底删除。";
        await LoadAsync();
    }
}
