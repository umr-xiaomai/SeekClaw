@page "/profile"
@page "/en/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SkillService Skills
@inject AuthService Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>@(IsEnglish ? "Personal Center — SeekClaw" : "个人中心 — SeekClaw")</PageTitle>

<section class="skills-shell" style="max-width: 1100px;">
    <!-- Profile Header -->
    <header class="skills-header mb-4 text-start">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="skill-icon-modern" style="width: 52px; height: 52px; font-size: 1.6rem; border-radius: 12px;">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div>
                    <h1 class="h4 fw-bold m-0 d-flex align-items-center gap-2">
                        <span>@_username</span>
                        @if (_isSuperAdmin)
                        {
                            <span class="badge-subtle badge-subtle-danger"><span class="dot"></span>超级管理员</span>
                        }
                        else
                        {
                            <span class="badge-subtle badge-subtle-neutral"><span class="dot"></span>认证开发者</span>
                        }
                    </h1>
                    <div class="text-muted small mt-1 font-monospace d-flex align-items-center gap-3">
                        <span><i class="bi bi-person me-1"></i>UID: @_userId</span>
                        <span><i class="bi bi-calendar3 me-1"></i>注册：@_joinTime</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn-modern btn-modern-primary" href="/skills/submit">
                    <i class="bi bi-cloud-arrow-up"></i>
                    <span>@(IsEnglish ? "Publish Skill" : "发布新技能")</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Overview Stats (Linear Metric Grid) -->
    <div class="metric-grid-modern">
        <div class="metric-card-modern">
            <div class="metric-card-header">
                <span>@(IsEnglish ? "Published Skills" : "我发布的技能")</span>
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="metric-card-value">@_mySkills.Count</div>
        </div>

        <div class="metric-card-modern">
            <div class="metric-card-header">
                <span>@(IsEnglish ? "Total Downloads" : "累计下载总量")</span>
                <i class="bi bi-download"></i>
            </div>
            <div class="metric-card-value">@_totalDownloads</div>
        </div>

        <div class="metric-card-modern">
            <div class="metric-card-header">
                <span>@(IsEnglish ? "Total Pageviews" : "累计页面浏览")</span>
                <i class="bi bi-eye"></i>
            </div>
            <div class="metric-card-value">@_totalViews</div>
        </div>

        <div class="metric-card-modern">
            <div class="metric-card-header">
                <span>@(IsEnglish ? "Under Review" : "审核中技能")</span>
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="metric-card-value" style="color: @(_pendingCount > 0 ? "#f59e0b" : "inherit");">@_pendingCount</div>
        </div>
    </div>

    <!-- Segmented Tab Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="segmented-bar">
            <button class="segmented-item @(_activeTab == "skills" ? "active" : "")" type="button" @onclick='() => _activeTab = "skills"'>
                <i class="bi bi-collection"></i>
                <span>@(IsEnglish ? "My Published Skills" : "我的技能管理")</span>
                <span class="small font-monospace opacity-75">(@_mySkills.Count)</span>
            </button>
            <button class="segmented-item @(_activeTab == "security" ? "active" : "")" type="button" @onclick='() => _activeTab = "security"'>
                <i class="bi bi-shield-lock"></i>
                <span>@(IsEnglish ? "Security Settings" : "账号安全设置")</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert-modern alert-modern-info mb-3">
            <i class="bi bi-check-circle-fill fs-5 flex-shrink-0 text-success"></i>
            <div class="flex-grow-1">@_statusMessage</div>
            <button type="button" class="btn-close" style="font-size: 0.75rem;" @onclick="() => _statusMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert-modern alert-modern-danger mb-3">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
            <div class="flex-grow-1">@_errorMessage</div>
            <button type="button" class="btn-close" style="font-size: 0.75rem;" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <!-- TAB 1: My Skills -->
    @if (_activeTab == "skills")
    {
        @if (_mySkills.Count == 0)
        {
            <div class="empty-state bg-transparent border rounded p-5 text-center">
                <i class="bi bi-box-seam text-muted fs-1 mb-2"></i>
                <h3 class="h5 fw-bold mb-2">@(IsEnglish ? "No Skills Published Yet" : "暂未发布任何技能插件")</h3>
                <p class="text-secondary small mb-3">@(IsEnglish ? "Share your custom Prompt SOPs, tool workflows, and coding helpers with the SeekClaw community!" : "将您编写的 Prompt SOP、工具协同流与编码辅助技能分享给 SeekClaw 社区开发者！")</p>
                <a class="btn-modern btn-modern-primary" href="/skills/submit">
                    <i class="bi bi-plus-lg"></i> @(IsEnglish ? "Publish First Skill" : "立即发布第一个技能")
                </a>
            </div>
        }
        else
        {
            <div class="table-modern-wrapper">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>技能名称 / Slug</th>
                            <th style="width: 120px;">当前版本</th>
                            <th style="width: 140px;">审核状态</th>
                            <th style="width: 140px;">热度度量</th>
                            <th style="width: 160px;">更新时间</th>
                            <th class="text-end" style="width: 220px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var skill in _mySkills)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-truncate" style="max-width: 260px;" title="@skill.Name">@skill.Name</div>
                                    <div class="small text-muted font-monospace" style="font-size: 0.75rem;">@skill.Slug</div>
                                </td>
                                <td>
                                    <span class="skill-version-pill">v@skill.Version</span>
                                    <div class="text-muted small mt-1 font-monospace" style="font-size: 0.72rem;">@skill.VersionCount 个版本</div>
                                </td>
                                <td>
                                    @if (skill.ReviewStatus == SkillReviewStatus.Approved)
                                    {
                                        <span class="badge-subtle badge-subtle-success"><span class="dot"></span>已上架</span>
                                    }
                                    else if (skill.ReviewStatus == SkillReviewStatus.Pending)
                                    {
                                        <span class="badge-subtle badge-subtle-warning"><span class="dot"></span>审核中</span>
                                    }
                                    else if (skill.ReviewStatus == SkillReviewStatus.Rejected)
                                    {
                                        <span class="badge-subtle badge-subtle-danger" title="@skill.ReviewComment"><span class="dot"></span>已驳回</span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-secondary font-monospace">
                                        <span title="累计下载"><i class="bi bi-download me-1 text-muted"></i>@skill.DownloadCount</span>
                                        <span class="ms-2" title="累计浏览"><i class="bi bi-eye me-1 text-muted"></i>@skill.ViewCount</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted font-monospace">@DateTimeOffset.FromUnixTimeMilliseconds(skill.UpdatedAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a class="btn-modern btn-modern-sm" href="@($"/skills/{skill.Slug}")" target="_blank" title="在新标签页预览">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                        <button class="btn-modern btn-modern-sm btn-modern-primary" @onclick="() => OpenAddVersionModal(skill)" title="发布新版本">
                                            <i class="bi bi-cloud-arrow-up"></i>
                                            <span>发版</span>
                                        </button>
                                        <button class="btn-modern btn-modern-sm" @onclick="() => OpenEditSkillModal(skill)" title="编辑元信息">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (_activeTab == "security")
    {
        <!-- TAB 2: Change Password -->
        <div class="aside-card" style="max-width: 520px;">
            <div class="aside-card-title">
                <i class="bi bi-shield-lock"></i>
                <span>修改账户安全密码</span>
            </div>
            <div class="mb-3">
                <label class="form-label small text-muted">原密码 *</label>
                <input type="password" class="form-control form-control-sm" @bind="_oldPassword" placeholder="请输入当前密码" />
            </div>
            <div class="mb-3">
                <label class="form-label small text-muted">新密码 *（至少 6 位）</label>
                <input type="password" class="form-control form-control-sm" @bind="_newPassword" placeholder="请输入新密码" />
            </div>
            <div class="mb-4">
                <label class="form-label small text-muted">确认新密码 *</label>
                <input type="password" class="form-control form-control-sm" @bind="_confirmPassword" placeholder="请再次输入新密码" />
            </div>
            <button class="btn-modern btn-modern-primary" disabled="@_savingPassword" @onclick="ChangePasswordAsync">
                <i class="bi bi-check-lg"></i>
                <span>@(_savingPassword ? "正在验证保存…" : "确认修改密码")</span>
            </button>
        </div>
    }

    <!-- Modal: Add New Version -->
    @if (_showVersionModal && _targetSkill != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="background: var(--seek-card-bg); border: 1px solid var(--seek-card-border); border-radius: 12px; box-shadow: var(--shadow-flyout);">
                    <div class="modal-header border-bottom" style="border-color: var(--seek-card-border) !important;">
                        <h5 class="modal-title fw-semibold h6 m-0 d-flex align-items-center gap-2">
                            <i class="bi bi-cloud-arrow-up text-success"></i>
                            <span>发布新版本 · @_targetSkill.Name</span>
                        </h5>
                        <button type="button" class="btn-close" @onclick="() => _showVersionModal = false"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(_modalError))
                        {
                            <div class="alert-modern alert-modern-danger mb-3">@_modalError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label small text-muted">新版本号 *</label>
                            <input class="form-control form-control-sm font-monospace" @bind="_versionInput.Version" placeholder="例如：1.1.0" />
                            <div class="form-text small">当前线上版本为 v@_targetSkill.Version</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">版本更新日志 (Changelog) *</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="_versionInput.Changelog" placeholder="简要说明本次版本更新的功能或缺陷修复…"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">上传技能包（.zip / .md / .json，最大 10MB）</label>
                            <InputFile class="form-control form-control-sm" OnChange="OnVersionPackageSelected" accept=".zip,.md,.txt,.json" />
                            @if (_versionPackageData != null)
                            {
                                <div class="form-text text-success small mt-1"><i class="bi bi-check-circle me-1"></i>已就绪：@_versionPackageFileName (@((_versionPackageData.Length / 1024.0).ToString("F1")) KB)</div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer border-top" style="border-color: var(--seek-card-border) !important;">
                        <button type="button" class="btn-modern" @onclick="() => _showVersionModal = false">取消</button>
                        <button type="button" class="btn-modern btn-modern-primary" disabled="@_submittingVersion" @onclick="SubmitNewVersionAsync">
                            @(_submittingVersion ? "正在打包提交…" : "确认发布版本")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal: Edit Skill Info -->
    @if (_showEditModal && _targetSkill != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content" style="background: var(--seek-card-bg); border: 1px solid var(--seek-card-border); border-radius: 12px; box-shadow: var(--shadow-flyout);">
                    <div class="modal-header border-bottom" style="border-color: var(--seek-card-border) !important;">
                        <h5 class="modal-title fw-semibold h6 m-0 d-flex align-items-center gap-2">
                            <i class="bi bi-pencil"></i>
                            <span>编辑技能元信息 · @_targetSkill.Name</span>
                        </h5>
                        <button type="button" class="btn-close" @onclick="() => _showEditModal = false"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(_modalError))
                        {
                            <div class="alert-modern alert-modern-danger mb-3">@_modalError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label small text-muted">技能显示名称 *</label>
                            <input class="form-control form-control-sm" @bind="_editInput.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">一句话简介</label>
                            <input class="form-control form-control-sm" @bind="_editInput.Summary" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">项目主页或文档外链</label>
                            <input class="form-control form-control-sm" @bind="_editInput.Homepage" placeholder="https://github.com/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">README 使用说明（Markdown）</label>
                            <textarea class="form-control form-control-sm font-monospace" rows="8" @bind="_editInput.ReadmeMarkdown" placeholder="# 技能文档..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top" style="border-color: var(--seek-card-border) !important;">
                        <button type="button" class="btn-modern" @onclick="() => _showEditModal = false">取消</button>
                        <button type="button" class="btn-modern btn-modern-primary" disabled="@_submittingEdit" @onclick="SubmitEditSkillAsync">
                            @(_submittingEdit ? "正在保存…" : "保存更新")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private bool IsEnglish => Navigation.Uri.Contains("/en/");
    private int _userId;
    private string _username = "";
    private bool _isSuperAdmin;
    private string _joinTime = "";
    private string _activeTab = "skills";

    private List<SkillSummary> _mySkills = [];
    private int _totalDownloads => _mySkills.Sum(s => s.DownloadCount);
    private int _totalViews => _mySkills.Sum(s => s.ViewCount);
    private int _pendingCount => _mySkills.Count(s => s.ReviewStatus == SkillReviewStatus.Pending);

    private string? _statusMessage;
    private string? _errorMessage;

    // Security password change form
    private string _oldPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _savingPassword;

    // Modals
    private bool _showVersionModal;
    private bool _showEditModal;
    private SkillSummary? _targetSkill;
    private string? _modalError;

    private SkillVersionInput _versionInput = new();
    private byte[]? _versionPackageData;
    private string? _versionPackageFileName;
    private bool _submittingVersion;

    private UserSkillUpdateInput _editInput = new();
    private bool _submittingEdit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _username = user.Identity.Name ?? "";
            _isSuperAdmin = user.IsInRole("SuperAdmin");
            if (int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id))
            {
                _userId = id;
                var dbUser = await Auth.GetByIdAsync(_userId);
                if (dbUser != null)
                {
                    _joinTime = DateTimeOffset.FromUnixTimeMilliseconds(dbUser.CreatedAt).ToLocalTime().ToString("yyyy-MM-dd");
                }
                await LoadSkillsAsync();
            }
        }
    }

    private async Task LoadSkillsAsync()
    {
        if (_userId > 0)
        {
            _mySkills = await Skills.ListUserSkillsAsync(_userId);
        }
    }

    private async Task ChangePasswordAsync()
    {
        _statusMessage = null;
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_oldPassword))
        {
            _errorMessage = "请输入原密码。";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6)
        {
            _errorMessage = "新密码长度至少需要 6 位。";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "两次输入的新密码不一致。";
            return;
        }

        _savingPassword = true;
        try
        {
            var success = await Auth.ChangePasswordAsync(_userId, _oldPassword, _newPassword);
            if (!success)
            {
                _errorMessage = "原密码不正确，请重新输入。";
            }
            else
            {
                _statusMessage = "密码已成功修改！";
                _oldPassword = "";
                _newPassword = "";
                _confirmPassword = "";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "修改密码失败：" + ex.Message;
        }
        finally
        {
            _savingPassword = false;
        }
    }

    private void OpenAddVersionModal(SkillSummary skill)
    {
        _targetSkill = skill;
        _modalError = null;
        _versionInput = new SkillVersionInput
        {
            Version = BumpVersion(skill.Version),
            Changelog = ""
        };
        _versionPackageData = null;
        _versionPackageFileName = null;
        _showVersionModal = true;
    }

    private async Task OnVersionPackageSelected(InputFileChangeEventArgs e)
    {
        _modalError = null;
        var file = e.File;
        if (file is null) return;

        if (file.Size > SkillService.MaxPackageSizeBytes)
        {
            _modalError = "文件大小不能超过 10MB。";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: SkillService.MaxPackageSizeBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _versionPackageData = memory.ToArray();
            _versionPackageFileName = file.Name;
        }
        catch (Exception ex)
        {
            _modalError = "读取文件失败：" + ex.Message;
        }
    }

    private async Task SubmitNewVersionAsync()
    {
        if (_targetSkill == null) return;
        _modalError = null;

        if (string.IsNullOrWhiteSpace(_versionInput.Version))
        {
            _modalError = "请输入新版本号。";
            return;
        }

        _submittingVersion = true;
        try
        {
            await Skills.AddVersionAsync(
                _targetSkill.Id,
                _versionInput,
                _versionPackageData,
                _versionPackageFileName,
                _isSuperAdmin,
                _userId);

            _statusMessage = $"技能【{_targetSkill.Name}】成功发布新版本 v{_versionInput.Version}！";
            _showVersionModal = false;
            await LoadSkillsAsync();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _submittingVersion = false;
        }
    }

    private async Task OpenEditSkillModal(SkillSummary skill)
    {
        _targetSkill = skill;
        _modalError = null;
        var detail = await Skills.GetDetailAsync(skill.Id);
        if (detail != null)
        {
            _editInput = new UserSkillUpdateInput
            {
                Name = detail.Name,
                Summary = detail.Summary,
                ReadmeMarkdown = detail.ReadmeMarkdown,
                Homepage = detail.Homepage
            };
            _showEditModal = true;
        }
    }

    private async Task SubmitEditSkillAsync()
    {
        if (_targetSkill == null) return;
        _modalError = null;

        if (string.IsNullOrWhiteSpace(_editInput.Name))
        {
            _modalError = "技能名称不能为空。";
            return;
        }

        _submittingEdit = true;
        try
        {
            var success = await Skills.UpdateUserSkillAsync(_targetSkill.Id, _userId, _editInput);
            if (success)
            {
                _statusMessage = $"技能【{_editInput.Name}】基本信息已更新。";
                _showEditModal = false;
                await LoadSkillsAsync();
            }
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _submittingEdit = false;
        }
    }

    private static string BumpVersion(string current)
    {
        var parts = current.Trim().TrimStart('v').Split('.');
        if (parts.Length == 3 && int.TryParse(parts[2], out var patch))
        {
            return $"{parts[0]}.{parts[1]}.{patch + 1}";
        }
        return $"{current}.1";
    }
}
