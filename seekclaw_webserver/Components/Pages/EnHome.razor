@page "/en"

<PageTitle>SeekClaw — AI Agent Runtime</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <img class="hero-logo" src="/logo.png" alt="SeekClaw" />
        <h1>SeekClaw</h1>
        <p class="lead">A local-first, open-source, extensible general-purpose AI Agent Runtime</p>
        <p>Built on .NET 10, SeekClaw drives Desktop, CLI, and the skills ecosystem with one Runtime, configuration, tools, and session data.</p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="/en/doc/quickstart"><i class="bi bi-rocket-takeoff"></i> Quick Start</a>
            <a class="btn btn-outline-light" href="/en/skills"><i class="bi bi-stars"></i> Skills Marketplace</a>
        </div>
    </div>
    <div class="hero-visual">
        <img src="/screenshots/desktop/chat-and-projects.png" alt="SeekClaw Desktop main window" />
    </div>
</section>

<section class="section">
    <div class="section-heading">
        <h2>Runtime First</h2>
        <p>Business logic, provider routing, tool execution, session storage, and verification live in the Runtime. Frontends focus on presentation.</p>
    </div>
    <div class="feature-grid">
        <div class="feature-card">
            <h3>Providers</h3>
            <p>Anthropic, OpenAI-compatible APIs, Google, OpenRouter, Ollama, LM Studio, and more.</p>
        </div>
        <div class="feature-card">
            <h3>Tools & MCP</h3>
            <p>Built-in file, search, shell, and web tools with stdio / SSE MCP server extensions.</p>
        </div>
        <div class="feature-card">
            <h3>Skills ecosystem</h3>
            <p>Publish, download, and reuse portable skills from the official marketplace.</p>
        </div>
        <div class="feature-card">
            <h3>Verification & repair</h3>
            <p>After file edits, build checks can feed errors back to the agent for self-healing.</p>
        </div>
    </div>
</section>

<section class="section section-dark">
    <div class="section-heading">
        <h2>Desktop Preview</h2>
        <p>Desktop connects to or starts the Daemon automatically, so end users do not need .NET installed.</p>
    </div>
    <div class="screenshot-grid">
        <img src="/screenshots/desktop/providers-and-models.png" alt="Models and Providers" />
        <img src="/screenshots/desktop/diagnostics-and-usage.png" alt="Runtime diagnostics and usage" />
        <img src="/screenshots/desktop/mcp-servers.png" alt="MCP Server configuration" />
    </div>
</section>

