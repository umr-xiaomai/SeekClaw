<!DOCTYPE html>
<html lang="zh-CN" data-theme="light" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('seekclaw-theme') || 'light';
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (error) { }
        })();
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/font/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["seekclaw_webserver.styles.css"]" />
    <link id="hljs-theme" rel="stylesheet" href="@Assets["lib/highlight.js/styles/github.min.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="logo.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="InteractiveServer" />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="@Assets["lib/highlight.js/highlight.min.js"]"></script>
    <script src="@Assets["lib/mermaid/dist/mermaid.min.js"]"></script>
    <script src="@Assets["js/site.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>



